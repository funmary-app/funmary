{
	$schema: "https://docs.renovatebot.com/renovate-schema.json",
	extends: [
		"config:recommended",
		"helpers:pinGitHubActionDigests",
		":timezone(Asia/Tokyo)",
	],
	schedule: ["* 10 * * 1"],
	minimumReleaseAge: "3 days",
	lockFileMaintenance: {
		enabled: true,
		automerge: true,
		schedule: ["* 10 * * 1"],
		commitMessageAction: "lockfile を更新",
		commitMessageTopic: "",
		commitMessageExtra: "",
	},
	vulnerabilityAlerts: {
		schedule: ["at any time"],
	},
	ignorePaths: [
		"**/node_modules/**",
		"**/bower_components/**",
		"**/vendor/**",
		"**/examples/**",
		"**/__tests__/**",
		"**/test/**",
		"**/tests/**",
		"**/__fixtures__/**",
		"**/.agents/**",
	],
	labels: ["dependencies"],
	dependencyDashboard: {
		title: "依存の更新の一覧 (Dependency Dashboard)",
	},
	commitMessageAction: "依存を更新:",
	commitMessageTopic: "{{depName}}",
	commitMessageExtra: "→ {{#if newValue}}{{{newValue}}}{{else}}{{{newDigestShort}}}{{/if}}",
	customManagers: [
		{
			customType: "regex",
			managerFilePatterns: ["/^\\.github/workflows/.+\\.ya?ml$/"],
			matchStrings: ["ghcr\\.io/gitleaks/gitleaks:(?<currentValue>v[\\d.]+)"],
			depNameTemplate: "ghcr.io/gitleaks/gitleaks",
			datasourceTemplate: "docker",
		},
	],
	packageRules: [
		{
			matchUpdateTypes: ["minor", "patch", "digest"],
			groupName: "パッチとマイナー",
			groupSlug: "non-major",
			commitMessageTopic: "パッチとマイナー",
			commitMessageExtra: "",
			automerge: true,
		},
		{
			matchPackageNames: ["@smui/**", "@smui-extra/**", "smui-theme"],
			groupName: "SMUI",
			groupSlug: "smui",
			commitMessageTopic: "SMUI",
			commitMessageExtra: "",
		},
		{
			matchDepNames: ["node"],
			matchUpdateTypes: ["major"],
			enabled: false,
		},
		{
			matchPackageNames: ["@types/node"],
			allowedVersions: "24.x",
		},
		{
			matchUpdateTypes: ["major"],
			automerge: false,
			labels: ["dependencies", "major"],
		},
	],
}
