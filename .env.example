# Funmary の環境変数の例
#
# 手元の開発とテストでは、このファイルを .env に写して値を書きます (pnpm funmary-admin init でも作れます)。.env は Git の管理対象外です。.env.local などは使いません。
# 本番の値は手元に置かず、VPS の /etc/funmary/funmary.env に同じ形で書きます。
# 新しい変数が増えたときは、pnpm env:migrate で、値を変えずに .env の並びをこのファイルに合わせられます。
# 本番の環境変数ファイルは、pnpm env:upload で、VPS にログインせずに同じことができます (接続先は .env.ssh に書き、値の上書きは 1 つずつ確認します)。
# 空の値は "設定しない" を意味し、既定値が使われます。起動時に値を検証し、足りない値や形式の誤りがあれば、どの変数をどう直すかを表示して止まります。
# 年度や学期に関わる値は、ここには置きません。

# ---- サーバー ----

# 公開 URL。本番では必須
ORIGIN=
# 待ち受けるアドレスとポート。既定は 127.0.0.1 と 28461 (ほかのソフトと被りにくい、IANA で未割り当ての番号)
HOST=
PORT=
# DB とバックアップの置き場所。空なら、systemd の StateDirectory= が渡す STATE_DIRECTORY を使い、それもなければ ./data を使う
DATA_DIR=

# ---- 鍵 (必須。pnpm funmary-admin init が生成する) ----

SESSION_SECRET=
ENCRYPTION_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# プッシュ通知のサービス (Google、Mozilla、Apple) に伝える連絡先。mailto: のメールアドレスか https:// の URL を書く。空なら ORIGIN を使い、どちらもなければプッシュ通知を止める
VAPID_SUBJECT=

# ---- Google のログイン (必須) ----

# Google Cloud Console で作った OAuth クライアント (種類は "ウェブ アプリケーション")
# 承認済みのリダイレクト URI は <公開 URL>/auth/google/callback。手元では http://localhost:5173/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- 登録と管理者 ----

# ログインを許すメールアドレスのドメイン (カンマ区切り)。既定は fun.ac.jp
ALLOWED_EMAIL_DOMAINS=
# 一般ユーザーが毎月発行できる招待コードの数。既定は 0 (管理者だけが発行する)
INVITES_PER_USER=
# 管理者のメールアドレス (カンマ区切り)
ADMIN_EMAILS=

# ---- 取得元 ----

# 学生ポータルのアカウント。本番では必須。開発中は空でよい
PORTAL_USER_ID=
PORTAL_PASSWORD=
# 取得を止める取得元 (カンマ区切り)。緊急用
SOURCES_DISABLED=
# 開発用。指定すると、取得元に接続せず、このディレクトリの保存済みの HTML から読み込む
SOURCES_FIXTURE_DIR=
# バスの時刻表 API の基準の URL (契約は hakobus-types)。書いたときだけ、バスの機能が有効になる
BUS_API_BASE_URL=
# 学内の Wi-Fi の IPv4 アドレスの範囲 (カンマ区切り。例: 203.0.113.0/24)。バスの画面が、学内では未来大から出る向きを、はじめに出すのに使う。空なら使わない。管理画面の「学内のネットワーク」でも登録でき、両方を合わせて使う
CAMPUS_IP_RANGES=

# ---- 通知 ----

# メールの送信に使う SMTP サーバー。空ならメールの機能は無効
SMTP_URL=
MAIL_FROM=
# 管理用の Discord の Webhook の URL。取得元の不調、エラー、VPS への反映の結果など、Funmary 自体の状態が届く
# 利用者が授業の通知を受け取るための Webhook とは別のもので、利用者の Webhook は各自が設定画面で登録する。空ならログにだけ残す
ADMIN_DISCORD_WEBHOOK_URL=
# 管理用の Discord の Bot。トークンとギルド (サーバー) の ID の両方を書くと、Bot で送る (Webhook より先に使う)
# Bot は、チャンネルとロールを自分で作る。今後の更新で、Bot にさせることが増えても手直しが要らないよう、権限は「管理者」を与えることを勧める
# (Bot のトークンは秘密情報として扱い、専用の非公開のサーバーで使う)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# 利用者の Discord 連携 (設定の「Discord連携」)。Bot と同じ Discord Application の「OAuth2」タブにある Client ID と Secret
# 承認済みのリダイレクト URI は <公開 URL>/app/settings/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 開発中は既定で送信せず、内容をコンソールに出す。false にすると実際に送る
NOTIFY_DRY_RUN=

# ---- 監視とログ ----

# 定期処理の完了を知らせる監視サービス (healthchecks.io など) の URL
HEARTBEAT_URL=
# debug、info、warn、error のどれか。既定は本番で info、開発で debug
LOG_LEVEL=
# text (既定) か json
LOG_FORMAT=

# ---- リバースプロキシ (本番のみ) ----

# 利用者の IP アドレスを得るための設定。nginx なら X-Forwarded-For と 1
ADDRESS_HEADER=
XFF_DEPTH=

# ---- セルフホストの運営者 (任意) ----

# フッターに、運営者の名前と連絡先の URL を出す (Issue #109)。両方書くか、両方空にする
OPERATOR_NAME=
OPERATOR_URL=

# ロゴ、アイコン、URL を共有したときの画像を、自分の画像に差し替えるディレクトリ。
# ロゴとアイコンはコードのライセンスの対象外 (LICENSE-ASSETS) なので、セルフホストでは必ず差し替える。
# 置ける名前: icon.svg、icon-dark.svg、icon-192.png、icon-512.png、icon-maskable-512.png、apple-touch-icon.png、og-image.png、logo-light.svg、logo-dark.svg
# 置いていない名前は、同梱の画像を使う
BRAND_DIR=

# 問い合わせ先のメールアドレス。「このアプリについて」の画面に出す (ロゴの利用の許可などの連絡先)。空なら出さない
CONTACT_EMAIL=
