# pnpm env:upload と pnpm vps:restart が使う、VPS への SSH 接続先。
# 手元でこのファイルを .env.ssh に写して値を書きます。.env.ssh は Git の管理対象外です。
# 反映専用の制限された鍵 (funmary-deploy) ではなく、自分の SSH 鍵と sudo を使います。

# SSH の宛先。ユーザー名を含めて書く (funmary-update と同じ VPS)。
# ~/.ssh/config の Host 名も書ける。そのときは User と IdentityFile をその設定から読む。
# 公開鍵認証だけで接続し、パスワード認証では接続しない (鍵が見つからなければ止まる)
SSH_HOST=

# SSH の秘密鍵のパス。省略すると、ssh の既定 (~/.ssh/config の設定や ~/.ssh/id_ed25519 など) を使う。
# パスフレーズ付きの鍵なら、接続のたびに端末で聞かれる (pnpm env:upload は 2 回)。先に ssh-agent に登録すれば聞かれない
SSH_KEY=

# 使う ssh のコマンド。省略すると、Windows では Windows の OpenSSH (C:\Windows\System32\OpenSSH\ssh.exe)、
# ほかでは PATH の ssh を使う (Git for Windows の ssh は、パスフレーズを聞くときに失敗することがあるため)
SSH_BIN=

# SSH のポート。省略すると 22
SSH_PORT=

# 書き換える環境変数ファイル。省略すると /etc/funmary/funmary.env
REMOTE_ENV_FILE=
